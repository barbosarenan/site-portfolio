---
import Base from "../../../layouts/Base.astro";
import ArtigoCard from "../../../components/ArtigoCard.astro";
import { perfil, idPessoa } from "../../../dados/perfil";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const artigos = await getCollection("articles", ({ data }) => !data.rascunho);

  return artigos.map((a) => ({
    params: { slug: a.id },
    props: { a, todos: artigos },
  }));
}

const { a, todos } = Astro.props;
const { Content } = await render(a);

const fmt = (d) =>
  d.toLocaleDateString("en-US", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const capa = a.data.capa ?? "/og-en.jpg";
const url = new URL(Astro.url.pathname, Astro.site).href;
const publicado = a.data.data.toISOString();
const modificado = (a.data.atualizado ?? a.data.data).toISOString();
const palavras = (a.body ?? "").split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.round(palavras / 200));

// Leia também: artigos com mais tags em comum, depois os mais recentes.
const relacionados = todos
  .filter((o) => o.id !== a.id)
  .map((o) => ({ o, comum: o.data.tags.filter((t) => a.data.tags.includes(t)).length }))
  .sort((x, y) => y.comum - x.comum || y.o.data.data - x.o.data.data)
  .slice(0, 3)
  .map((r) => r.o);

const artigoSchema = {
  "@type": "BlogPosting",
  "@id": url + "#artigo",
  headline: a.data.titulo,
  description: a.data.resumo,
  datePublished: publicado,
  dateModified: modificado,
  inLanguage: "en",
  translationOfWork: { "@id": new URL("/artigos/" + a.data.pt + "/", Astro.site).href + "#artigo" },
  keywords: a.data.tags.join(", "),
  wordCount: palavras,
  timeRequired: "PT" + minutos + "M",
  url,
  author: { "@id": idPessoa },
  publisher: { "@id": idPessoa },
  mainEntityOfPage: { "@id": url + "#pagina" },
  isPartOf: { "@type": "Blog", "@id": new URL("/en/articles/", Astro.site).href + "#blog" },
  image: { "@type": "ImageObject", url: new URL(capa, Astro.site).href, width: 1200, height: 630 },
};
---
<Base
  idioma="en"
  alternativa={"/artigos/" + a.data.pt + "/"}
  titulo={a.data.titulo + " · " + perfil.nome}
  descricao={a.data.descricao ?? a.data.resumo}
  tipo="article"
  imagem={capa}
  dataPublicacao={publicado}
  dataModificacao={modificado}
  tituloCurto={a.data.titulo}
  schema={[artigoSchema]}
>
  {a.data.tags.map((t) => <meta property="article:tag" content={t} slot="cabeca" />)}

  <article class="env abertura artigo-abertura">
    <p class="rotulo artigo-linha-meta">
      <span>By <a href="/en/about/" rel="author">{perfil.nome}</a></span>
      <span><time datetime={publicado}>{fmt(a.data.data)}</time></span>
      {a.data.atualizado && <span>Updated <time datetime={modificado}>{fmt(a.data.atualizado)}</time></span>}
      <span>{minutos} min read</span>
    </p>

    <h1>{a.data.titulo}</h1>
    <p class="resumo">{a.data.resumo}</p>
    <img class="artigo-capa-topo" src={capa} width="1200" height="630" alt="" fetchpriority="high" decoding="async" />

    {a.data.tags.length > 0 && (
      <div class="tags" style="margin-top:18px">
        {a.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </article>

  <div class="env secao forte">
    <div class="prosa rolagem">
      <Content />
    </div>

    <aside class="autor" aria-label="About the author">
      <p class="rotulo">About the author</p>
      <p><a href="/en/about/" rel="author"><strong>{perfil.nome}</strong></a> is a marketing analyst in Campinas, Brazil, working with SEO, content strategy and AI applied to marketing. The articles document methods and tests from practice, with sources listed at the end of each piece. They were originally written in Portuguese.</p>
      <p class="autor-links"><a class="text-link" href={perfil.linkedin} rel="me noopener">LinkedIn&nbsp;<span aria-hidden="true">↗</span></a><a class="text-link" href={perfil.github} rel="me noopener">GitHub&nbsp;<span aria-hidden="true">↗</span></a></p>
    </aside>
  </div>

  {relacionados.length > 0 && (
    <section class="env secao relacionados" aria-labelledby="leia-tambem">
      <div class="section-head"><div><span class="rotulo">Keep reading</span><h2 id="leia-tambem">Read next</h2></div></div>
      <div class="artigos-grade">
        {relacionados.map((r, i) => <ArtigoCard artigo={r} ordem={i} idioma="en" />)}
      </div>
    </section>
  )}

</Base>
