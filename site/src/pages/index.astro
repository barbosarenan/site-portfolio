---
import Figura from "../components/Figura.astro";
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import CaseDestaque from "../components/CaseDestaque.astro";
import ArtigoCard from "../components/ArtigoCard.astro";
import { perfil } from "../dados/perfil";
import { getCollection } from "astro:content";

const porOrdem = (a, b) => (a.data.ordem ?? 999) - (b.data.ordem ?? 999) || b.data.data - a.data.data;
const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort(porOrdem).slice(0, 2);
const competencias = [
  { titulo: "SEO e web", texto: "Diagnóstico, arquitetura de conteúdo e implementação de páginas que explicam a oferta.", href: "/projetos/site-institucional/", link: "Ver o case de redesign" },
  { titulo: "Conteúdo", texto: "Planejamento editorial a partir de consultas de busca, intenção e contexto de negócio.", href: "/artigos/pauta-search-console/", link: "Ler sobre o método de planejamento" },
  { titulo: "IA aplicada", texto: "Uso de IA na análise e revisão de conteúdo, com critérios para orientar a decisão humana.", href: "/artigos/auditoria-antes-de-publicar/", link: "Ler sobre a auditoria editorial" },
];
---
<Base titulo={perfil.nome + " · Marketing, SEO e IA aplicada"} descricao="Conheça meu trabalho com SEO, conteúdo e IA aplicada: projetos demonstrativos, decisões de implementação e métodos de análise editorial.">
  <section class="env editorial-hero">
<div class="hero-copy" data-revela>
    <span class="rotulo">Marketing · SEO · IA aplicada</span>
    <h1>SEO e conteúdo, com IA no processo.</h1>
    <p>Sou Renan Barbosa, analista de marketing em Campinas. Planejo e executo SEO, conteúdo e sites, e uso IA para analisar e revisar o trabalho.</p>
    <a class="botao" href="#trabalhos">Conheça meu trabalho <span aria-hidden="true">↓</span></a>
</div><Figura />
  </section>

  <section class="env secao" id="trabalhos">
    <div class="section-head" data-revela>
      <div><span class="rotulo">01 · projetos</span><h2>Trabalho selecionado.</h2></div>
      <div class="links-secao">
        <a class="text-link" href="/projetos/">Todos os projetos <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/lab/">Experimentos no AI Lab <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div data-revela><CaseDestaque /></div>
  </section>

  <section class="env secao">
    <div class="section-head" data-revela>
      <div><span class="rotulo">02 · competências</span><h2>Da análise à entrega.</h2></div>

    </div>
    <div class="competencias">
      {competencias.map((item, i) => (
        <article class="competencia" data-revela style={`--d:${i}`}>
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
          <a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="sobre-faixa" id="sobre"><div class="env secao breve-perfil" data-revela>
    <div><span class="rotulo">03 · sobre</span><h2>Marketing com<br /> repertório técnico.</h2></div>
    <div>
      <p>Minha formação é em marketing. A experiência com SEO, conteúdo e administração de sites ampliou esse repertório para desenvolvimento web, automação e inteligência artificial.</p>
      <a class="text-link" href="/sobre/">Conheça minha trajetória <span aria-hidden="true">↗</span></a>
    </div>
  </div></section>

  <section class="env secao" id="artigos">
    <div class="section-head" data-revela>
      <div><span class="rotulo">04 · artigos</span><h2>Notas e métodos.</h2></div>
      <a class="text-link" href="/artigos/">Todos os artigos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="artigos-grade">
      {artigos.map((a, i) => <ArtigoCard artigo={a} ordem={i} />)}
    </div>
  </section>
  <Chamada />
</Base>

