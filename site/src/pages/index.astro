---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import CaseDestaque from "../components/CaseDestaque.astro";
import { perfil } from "../dados/perfil";
import { getCollection } from "astro:content";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data).slice(0, 3);
const fmt = (d) => d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });
const competencias = [
  { titulo: "SEO e web", texto: "Diagnóstico, arquitetura de conteúdo e implementação de páginas que explicam a oferta.", href: "/projetos/compasso/", link: "Ver aplicação no case Compasso" },
  { titulo: "Conteúdo", texto: "Planejamento editorial a partir de consultas de busca, intenção e contexto de negócio.", href: "/artigos/pauta-search-console/", link: "Ler sobre o método de planejamento" },
  { titulo: "IA aplicada", texto: "Uso de IA na análise e revisão de conteúdo, com critérios para orientar a decisão humana.", href: "/artigos/auditoria-antes-de-publicar/", link: "Ler sobre a auditoria editorial" },
];
---
<Base titulo={perfil.nome + " · marketing, SEO e IA aplicada"}>
  <section class="env editorial-hero">
    <span class="rotulo">Marketing · SEO · IA aplicada</span>
    <h1>Estratégia, conteúdo<br /> e execução digital.</h1>
    <p>Sou Renan Barbosa. Trabalho com SEO, conteúdo e aplicações de IA para organizar processos e construir experiências digitais.</p>
    <a class="text-link" href="#trabalhos">Conheça meu trabalho <span aria-hidden="true">↓</span></a>
  </section>

  <section class="env secao" id="trabalhos">
    <div class="section-head">
      <div><span class="rotulo">01 · projetos</span><h2>Trabalho selecionado.</h2></div>
      <a class="text-link" href="/projetos/">Projetos e experimentos <span aria-hidden="true">↗</span></a>
    </div>
    <CaseDestaque />
  </section>

  <section class="env secao">
    <div class="section-head">
      <div><span class="rotulo">02 · competências</span><h2>Da análise à entrega.</h2></div>
      <a class="text-link" href="/servicos/">Como posso contribuir <span aria-hidden="true">↗</span></a>
    </div>
    <div class="competencias">
      {competencias.map((item) => (
        <article class="competencia">
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
          <a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="env secao breve-perfil">
    <div><span class="rotulo">03 · sobre</span><h2>Marketing com<br /> repertório técnico.</h2></div>
    <div>
      <p>Minha formação é em marketing. A experiência com SEO, conteúdo e administração de sites ampliou esse repertório para desenvolvimento web, automação e inteligência artificial.</p>
      <p>Atuo na conexão entre estratégia e execução, buscando compreender o problema antes de escolher ferramentas.</p>
      <a class="text-link" href="/sobre/">Conheça minha trajetória <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div><span class="rotulo">04 · artigos</span><h2>Notas e métodos.</h2></div>
      <a class="text-link" href="/artigos/">Todos os artigos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="lista-artigos">
      {artigos.map((a) => (
        <article class="artigo-linha">
          <time datetime={a.data.data.toISOString()}>{fmt(a.data.data)}</time>
          <a href={"/artigos/" + a.id + "/"}><h3>{a.data.titulo}</h3><p>{a.data.resumo}</p></a>
          <a class="artigo-arrow" href={"/artigos/" + a.id + "/"} aria-label={"Ler " + a.data.titulo}>↗</a>
        </article>
      ))}
    </div>
  </section>
  <Chamada titulo="Vamos conversar sobre seu próximo projeto?" />
</Base>

<style>
  .editorial-hero { padding-block: 64px 32px; }
  .editorial-hero h1 { margin-bottom: 24px; }
  .editorial-hero > p { max-width: 57ch; color: var(--muted); font-size: 17px; margin-bottom: 12px; }
  .competencias { border-top: 1px solid var(--line); }
  .competencia { display: grid; grid-template-columns: 170px minmax(0, 1fr) 210px; gap: 28px; align-items: start; padding-block: 26px; border-bottom: 1px solid var(--line); }
  .competencia p { color: var(--muted); font-size: 14px; margin: 0; }
  .competencia .text-link { font-size: 12px; justify-content: space-between; }
  .breve-perfil { display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; }
  .breve-perfil p { color: var(--muted); }
  @media (max-width: 760px) {
    .competencia { grid-template-columns: 150px minmax(0, 1fr); gap: 12px 24px; }
    .competencia .text-link { grid-column: 2; justify-content: flex-start; }
    .breve-perfil { gap: 32px; }
  }
  @media (max-width: 600px) {
    .editorial-hero { padding-block: 42px 16px; }
    .editorial-hero > p { font-size: 16px; }
    .competencia, .breve-perfil { grid-template-columns: 1fr; gap: 14px; }
    .competencia .text-link { grid-column: auto; }
    .breve-perfil { gap: 24px; }
  }
</style>