---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, marcadores, areas, casos } from "../dados/perfil";
import { getCollection } from "astro:content";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data)
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
---
<Base titulo={`${perfil.nome} · ${perfil.cargo}`}>
  <section class="env abertura">
    <p class="rotulo">{perfil.cargo} · {perfil.local}</p>
    <h1 class="linha-um">Estratégia de conteúdo orientada a busca.</h1>
    <p class="identidade">{perfil.nome} · {perfil.cargo} na UniSoma · {perfil.local}</p>
    <p class="resumo">
      Atuo com SEO, produção de conteúdo e edição de vídeo. Utilizo
      inteligência artificial nas etapas em que ela contribui de forma
      consistente, e a mantenho fora daquelas em que o erro tem custo elevado.
    </p>
  </section>

  <section class="env secao">
    <div class="numeros">
      {marcadores.map((m) => (
        <div class="numero">
          <span class="valor">{m.valor}</span>
          <span class="desc">{m.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="env secao forte">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">01 · áreas de atuação</span>
        <p>Quatro frentes de trabalho. As duas primeiras concentram a maior parte da rotina.</p>
      </div>
      <div class="itens">
        {areas.map((a) => (
          <article class="item">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">02 · casos</span>
        <p>Escopo, decisão e responsabilidade. Número de projeto de empresa é informação interna, e não entra aqui.</p>
      </div>
      <div class="itens">
        {casos.map((c) => (
          <article class="item">
            <h3>{c.titulo}{c.nota && <span class="exemplo">{c.nota}</span>}</h3>
            <p class="rotulo" style="margin:4px 0 8px">{c.papel}</p>
            <p>{c.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">03 · publicações</span>
        <p>Método, testes e resultados, inclusive os que não se confirmaram. <a href="/artigos/">Ver todas</a>.</p>
      </div>
      <div class="lista-artigos">
        {artigos.map((a) => (
          <article class="artigo-linha">
            <time datetime={a.data.data.toISOString()}>{fmt(a.data.data)}</time>
            <a href={`/artigos/${a.id}/`}>
              <h3>{a.data.titulo}</h3>
              <p>{a.data.resumo}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Chamada />
</Base>
