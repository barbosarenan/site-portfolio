---
import Base from "../layouts/Base.astro";
import { perfil, lab, repositorios, idPessoa } from "../dados/perfil";

const usuarioGithub = perfil.github.replace(/\/$/, "").split("/").pop();
const githubIcone = "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";

const listaRepos = {
  "@type": "ItemList",
  name: "Repositórios públicos de " + perfil.nome,
  itemListElement: repositorios.map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareSourceCode",
      name: r.titulo,
      description: r.texto,
      codeRepository: perfil.github.replace(/\/$/, "") + "/" + r.nome,
      programmingLanguage: r.linguagem,
      author: { "@id": idPessoa },
    },
  })),
};
---
<Base
  titulo={"AI Lab: experimentos com IA e automação · " + perfil.nome}
  descricao="Protótipos e experimentos de Renan Barbosa com IA generativa, automação e desenvolvimento web, com o código aberto no GitHub."
  tipoPagina="CollectionPage"
  tituloCurto="AI Lab"
  schema={[listaRepos]}
>
  <section class="env lab-hero">
    <div>
      <span class="rotulo status">AI Lab</span>
      <h1>Experimentos com IA e automação, <em>com código aberto.</em></h1>
      <p class="resumo">Protótipos com código aberto no GitHub e ideias que ainda estão em teste.</p>
    </div>
    <aside class="github-card" aria-label="Perfil no GitHub">
      <svg class="github-marca" viewBox="0 0 16 16" aria-hidden="true"><path d={githubIcone} /></svg>
      <div class="github-topo">
        <span class="selo grande" aria-hidden="true">RB</span>
        <div><strong>{perfil.nome}</strong><span class="rotulo">@{usuarioGithub}</span></div>
      </div>
      <p>Marketing, SEO e IA generativa. Código dos protótipos, deste site e dos experimentos.</p>
      <a class="botao claro" href={perfil.github} rel="me noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d={githubIcone} fill="currentColor" /></svg>
        Ver perfil no GitHub
      </a>
    </aside>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div><span class="rotulo">01 · GitHub</span><h2>Repositórios</h2></div>
      <a class="text-link" href={perfil.github} rel="me noopener">github.com/{usuarioGithub} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="repos-grade">
      {repositorios.map((r) => (
        <article class="repo-card">
          <div class="repo-topo">
            <span class="estagio">{r.estagio}</span>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d={githubIcone} fill="currentColor" /></svg>
          </div>
          <h3><a class="repo-link" href={perfil.github.replace(/\/$/, "") + "/" + r.nome} rel="noopener">{r.titulo}</a></h3>
          <code>{usuarioGithub}/{r.nome}</code>
          <p>{r.texto}</p>
          <div class="repo-rodape">
            <span class="linguagem"><i style={`background:${r.cor}`}></i>{r.linguagem}</span>
            <span aria-hidden="true">Ver no GitHub ↗</span>
          </div>
        </article>
      ))}
      <a class="repo-card repo-todos" href={perfil.github} rel="me noopener">
        <span class="rotulo">Todos os repositórios</span>
        <strong>github.com/{usuarioGithub}</strong>
        <p>Código, commits e experimentos em andamento.</p>
        <span class="botao">Abrir perfil ↗</span>
      </a>
    </div>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div><span class="rotulo">02 · Em teste</span><h2>Ainda sem código público</h2></div>
    </div>
    <div class="cards-grid">
      {lab.map((item, i) => (
        <article class="project-card">
          <div class="project-top">
            <span class="project-number">{String(i + 1).padStart(2, "0")}</span>
            <span class="project-tag">{item.stack}</span>
          </div>
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
