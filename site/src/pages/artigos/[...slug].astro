---
import Base from "../../layouts/Base.astro";
import Chamada from "../../components/Chamada.astro";
import { perfil } from "../../dados/perfil";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const artigos = await getCollection("artigos", ({ data }) => !data.rascunho);

  return artigos.map((a) => ({
    params: { slug: a.id },
    props: { a },
  }));
}

const { a } = Astro.props;
const { Content } = await render(a);

const fmt = (d) =>
  d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const capa = a.data.capa ?? "/og.png";
const url = new URL(Astro.url.pathname, Astro.site).href;
const modificado = (a.data.atualizado ?? a.data.data).toISOString();

const dadosEstruturados = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: a.data.titulo,
  description: a.data.resumo,
  datePublished: a.data.data.toISOString(),
  dateModified: modificado,
  inLanguage: "pt-BR",
  keywords: a.data.tags.join(", "),
  url,
  author: {
    "@type": "Person",
    name: perfil.nome,
    url: Astro.site?.href,
    jobTitle: perfil.cargo,
    sameAs: [perfil.linkedin, perfil.github, perfil.instagram],
  },
  publisher: {
    "@type": "Person",
    name: perfil.nome,
  },
  mainEntityOfPage: url,
  image: new URL(capa, Astro.site).href,
};

const trilha = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Artigos", item: new URL("/artigos/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: a.data.titulo, item: url },
  ],
};
---
<Base
  titulo={a.data.titulo + " · " + perfil.nome}
  descricao={a.data.resumo}
  tipo="article"
  imagem={capa}
  dataPublicacao={a.data.data.toISOString()}
>
  <script
    type="application/ld+json"
    slot="cabeca"
    set:html={JSON.stringify(dadosEstruturados)}
  />
  <script type="application/ld+json" slot="cabeca" set:html={JSON.stringify(trilha)} />
  {a.data.tags.map((t) => <meta property="article:tag" content={t} slot="cabeca" />)}

  <article class="env abertura artigo-abertura">
    <p class="rotulo">
      <a href="/artigos/" style="color:inherit">artigos</a> · {fmt(a.data.data)}
    </p>

    <h1>{a.data.titulo}</h1>
    <p class="resumo">{a.data.resumo}</p>
    <img class="artigo-capa-topo" src={capa} width="1200" height="630" alt="" fetchpriority="high" decoding="async" />

    {a.data.tags.length > 0 && (
      <div class="tags" style="margin-top:18px">
        {a.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </article>

  <div class="env secao forte">
    <div class="prosa rolagem">
      <Content />
    </div>
  </div>

  <Chamada />
</Base>
