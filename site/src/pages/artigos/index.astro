---
import Base from "../../layouts/Base.astro";
import { perfil } from "../../dados/perfil";
import { getCollection } from "astro:content";
import ArtigoCard from "../../components/ArtigoCard.astro";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data);

const site = Astro.site;
const listaEstruturada = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Artigos · " + perfil.nome,
  description: "Métodos e notas sobre SEO, conteúdo e IA aplicada ao marketing.",
  url: new URL("/artigos/", site).href,
  inLanguage: "pt-BR",
  author: { "@type": "Person", name: perfil.nome, url: site?.href },
  blogPost: artigos.map((a) => ({
    "@type": "BlogPosting",
    headline: a.data.titulo,
    description: a.data.resumo,
    datePublished: a.data.data.toISOString(),
    url: new URL("/artigos/" + a.id + "/", site).href,
    image: new URL(a.data.capa ?? "/og.png", site).href,
  })),
};
---
<Base
  titulo={"Artigos sobre SEO, conteúdo e IA aplicada · " + perfil.nome}
  descricao="Métodos e notas sobre SEO, planejamento de conteúdo e uso de IA na revisão editorial, com exemplos aplicáveis ao dia a dia do marketing."
>
  <script type="application/ld+json" slot="cabeca" set:html={JSON.stringify(listaEstruturada)} />
  <section class="env abertura">
    <span class="rotulo">Artigos</span>
    <h1 class="linha-um">Conhecimento construído a partir da prática.</h1>
    <p class="resumo">Reflexões, análises e métodos desenvolvidos a partir de experiências com SEO, conteúdo, inteligência artificial e tecnologia.</p>
    <p class="resumo">Um espaço para registrar aprendizados e transformar experimentação em conhecimento aplicável.</p>
  </section>

  <section class="env secao">
    <div class="artigos-grade">
      {artigos.map((a, i) => <ArtigoCard artigo={a} nivel="h2" ordem={i} prioridade={i < 2} />)}
    </div>
  </section>
</Base>
