---
// "Trabalhos selecionados" da home em formato bento: dois cards lado a lado (um embaixo do outro no celular).
// Cada card tem um visual curto em cima, texto embaixo, e o card inteiro é clicável pelo link do título.
// A página Projetos continua com os cards grandes (CaseDestaque e CaseArtigos).
const { idioma = "pt" } = Astro.props;
const cases = {
  pt: [
    {
      etiqueta: "Case profissional · web · SEO",
      titulo: "Site institucional B2B",
      texto: "Redesign em WordPress organizado em torno de um novo posicionamento.",
      tags: ["Tema próprio", "SEO técnico", "Performance"],
      href: "/projetos/site-institucional/",
      visual: "site",
    },
    {
      etiqueta: "Case profissional · SEO · GEO · AEO",
      titulo: "Artigos no Google e na IA",
      texto: "Acompanhamento mensal e otimização de cerca de 20 artigos B2B.",
      tags: ["On-page", "Links internos", "GEO e AEO"],
      href: "/projetos/artigos-seo-geo/",
      visual: "serp",
    },
  ],
  en: [
    {
      etiqueta: "Professional case · web · SEO",
      titulo: "B2B institutional website",
      texto: "WordPress redesign organized around a new positioning.",
      tags: ["Custom theme", "Technical SEO", "Performance"],
      href: "/en/projects/institutional-website/",
      visual: "site",
    },
    {
      etiqueta: "Professional case · SEO · GEO · AEO",
      titulo: "Articles in search and AI",
      texto: "Monthly tracking and optimization of about 20 B2B articles.",
      tags: ["On-page", "Internal links", "GEO and AEO"],
      href: "/en/projects/seo-geo-articles/",
      visual: "serp",
    },
  ],
}[idioma];
const rotuloTags = idioma === "en" ? "Project scope" : "Frentes do projeto";
// Rótulos das capas (desenhadas em SVG para escalar sem perder nitidez).
const capa = {
  pt: { etapas: ["01 Decisão", "02 Processo", "03 Resultado", "04 Tecnologia"], busca: "Busca orgânica", ia: "Respostas de IA" },
  en: { etapas: ["01 Decision", "02 Process", "03 Result", "04 Technology"], busca: "Organic search", ia: "AI answers" },
}[idioma];
---
<div class="bento">
  {cases.map((c, i) => (
    <div class="bento-item" data-revela style={`--d:${i}`}>
    <article class:list={["bento-card", { destaque: i === 0 }]}>
      <div class:list={["bento-visual", c.visual]} aria-hidden="true">
        {c.visual === "site" ? (
          <svg class="capa-svg" viewBox="0 0 480 200" preserveAspectRatio="xMidYMid meet">
            <g class="capa-sombra"><rect x="128" y="20" width="224" height="166" rx="10" /></g>
            <rect x="128" y="16" width="224" height="166" rx="10" class="c-papel" />
            <line x1="128" y1="30" x2="352" y2="30" class="c-fino" />
            <circle cx="140" cy="23" r="2.4" class="c-ponto" /><circle cx="148" cy="23" r="2.4" class="c-ponto" /><circle cx="156" cy="23" r="2.4" class="c-ponto" />
            <circle cx="144" cy="43" r="5" class="c-verde" />
            {[158, 178, 198, 218].map((x) => <rect x={x} y="41.5" width="14" height="3" rx="1.5" class="c-item" />)}
            <rect x="306" y="38" width="32" height="10" rx="5" class="c-laranja" />
            <rect x="139" y="56" width="202" height="46" rx="5" class="c-verde" />
            <rect x="148" y="66" width="96" height="5" rx="2.5" class="c-claro" />
            <rect x="148" y="76" width="70" height="5" rx="2.5" class="c-claro" />
            <rect x="148" y="87" width="34" height="8" rx="4" class="c-laranja" />
            <rect x="262" y="63" width="70" height="32" rx="4" class="c-vidro" />
            {[110, 132, 154].map((y, i) => (
              <g>
                <rect x="139" y={y} width="202" height="16" rx="4" class:list={["c-bloco", { ultimo: i === 2 }]} />
                <rect x="147" y={y + 6.5} width="90" height="3" rx="1.5" class:list={["c-item", { ultimo: i === 2 }]} />
                <text x="331" y={y + 10.5} class="c-num" text-anchor="end">{"0" + (i + 2)}</text>
              </g>
            ))}
            <g class="c-anot">
              <line x1="100" y1="79" x2="124" y2="79" /><text x="96" y="82" text-anchor="end">{capa.etapas[0]}</text>
              <line x1="356" y1="118" x2="380" y2="118" /><text x="384" y="121">{capa.etapas[1]}</text>
              <line x1="100" y1="140" x2="124" y2="140" /><text x="96" y="143" text-anchor="end">{capa.etapas[2]}</text>
              <g class="c-anot-laranja"><line x1="356" y1="162" x2="380" y2="162" /><text x="384" y="165">{capa.etapas[3]}</text></g>
            </g>
          </svg>
        ) : (
          <svg class="capa-svg" viewBox="0 0 480 200" preserveAspectRatio="xMidYMid meet">
            <g class="c-rotulo"><rect x="24" y="14" width="112" height="18" rx="9" /><text x="80" y="26.5" text-anchor="middle">{capa.busca}</text></g>
            <g class="c-rotulo"><rect x="344" y="14" width="112" height="18" rx="9" /><text x="400" y="26.5" text-anchor="middle">{capa.ia}</text></g>
            <rect x="40" y="46" width="176" height="18" rx="9" class="c-busca" />
            <circle cx="54" cy="54.5" r="3.6" class="c-lupa" /><line x1="56.8" y1="57.3" x2="60" y2="60.5" class="c-lupa" />
            <rect x="66" y="53.5" width="88" height="3" rx="1.5" class="c-item" />
            {[0, 1, 2].map((i) => (
              <g>
                {i === 1 && <rect x="38" y={74 + i * 36} width="180" height="30" rx="5" class="c-destaque" />}
                {i === 1 && <rect x="38" y={74 + i * 36} width="3" height="30" class="c-laranja" />}
                <text x="48" y={93 + i * 36} class:list={["c-pos", { eu: i === 1 }]}>{i + 1}</text>
                <rect x="60" y={81 + i * 36} width="104" height="5" rx="2.5" class="c-verde" />
                <rect x="60" y={91 + i * 36} width="146" height="3" rx="1.5" class="c-item" />
              </g>
            ))}
            <rect x="262" y="58" width="190" height="112" rx="10" class="c-card" />
            <rect x="350" y="70" width="90" height="16" rx="8" class="c-balao" />
            <rect x="276" y="98" width="160" height="3.5" rx="1.75" class="c-resp" />
            <rect x="276" y="108" width="146" height="3.5" rx="1.75" class="c-resp" />
            <rect x="276" y="118" width="112" height="3.5" rx="1.75" class="c-resp" />
            {[0, 1, 2].map((i) => (
              <g>
                <rect x={276 + i * 26} y="136" width="20" height="14" rx="7" class:list={["c-cit", { eu: i === 1 }]} />
                <text x={286 + i * 26} y="146" text-anchor="middle" class:list={["c-citn", { eu: i === 1 }]}>{i + 1}</text>
              </g>
            ))}
            <path d="M 218 125 C 252 125, 268 160, 312 151" class="c-liga" />
          </svg>
        )}
      </div>
      <div class="bento-corpo">
        <p class="bento-etiqueta">{c.etiqueta}</p>
        <h3><a class="bento-link" href={c.href}>{c.titulo}</a></h3>
        <p class="bento-texto">{c.texto}</p>
        <div class="bento-rodape">
          <ul class="case-tags" aria-label={rotuloTags}>
            {c.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <span class="bento-seta" aria-hidden="true">↗</span>
        </div>
      </div>
    </article>
    </div>
  ))}
</div>
