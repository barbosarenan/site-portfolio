---
import "../styles/global.css";
import { perfil, idPessoa, idSite } from "../dados/perfil";
import { getCollection } from "astro:content";
import { textos, paresDePaginas } from "../i18n";

const {
  titulo,
  descricao,
  tipo = "website",
  imagem = "/og.png",
  dataPublicacao,
  dataModificacao,
  // Schema da página: WebPage, CollectionPage, ProfilePage...
  tipoPagina = "WebPage",
  // Nós extras de schema.org que a página quer somar ao grafo (BlogPosting, CreativeWork...).
  schema = [],
  // Trilha: por padrão é montada a partir da URL. "tituloCurto" nomeia o último item.
  tituloCurto,
  migalhas,
  semMigalhas = false,
  // Páginas que não devem aparecer nos buscadores (404, páginas sem links).
  semIndexar = false,
  // Idioma da página ("pt" ou "en") e endereço da mesma página no outro idioma, quando existe.
  idioma = "pt",
  alternativa,
} = Astro.props;

const t = textos[idioma];
const outroIdioma = idioma === "pt" ? "en" : "pt";

const site = Astro.site ?? new URL(perfil.site);
const canonica = new URL(Astro.url.pathname, site);
const desc = descricao ?? perfil.descricaoSite;
const imagemAbsoluta = new URL(imagem, site).href;
const tipoImagem = imagem.endsWith(".svg") ? "image/svg+xml" : imagem.endsWith(".jpg") || imagem.endsWith(".jpeg") ? "image/jpeg" : "image/png";

const rotas = t.rotas;

const aqui = Astro.url.pathname;
const estaAtiva = (href) => (href === t.inicio ? aqui === t.inicio : aqui.startsWith(href));

// ---------- Versões em outro idioma (seletor e hreflang) ----------
const invertidos = Object.fromEntries(Object.entries(paresDePaginas).map(([pt, en]) => [en, pt]));
const aquiComBarra = aqui.endsWith("/") ? aqui : aqui + "/";
const parAutomatico = idioma === "pt" ? paresDePaginas[aquiComBarra] : invertidos[aquiComBarra];
const urlAlternativa = alternativa ?? parAutomatico;
const hrefPt = idioma === "pt" ? aquiComBarra : urlAlternativa;
const hrefEn = idioma === "en" ? aquiComBarra : urlAlternativa;
// Sem par, o seletor leva para a página inicial do outro idioma, mas sem hreflang.
const destinoSeletor = urlAlternativa ?? textos[outroIdioma].inicio;

// ---------- Trilha de navegação (breadcrumbs) ----------
const nomes = t.nomesTrilha;
function montarTrilha() {
  let partes = aqui.split("/").filter(Boolean);
  if (idioma === "en") partes = partes.slice(1);
  if (partes.length === 0) return [];
  const itens = [{ nome: t.nomeInicio, href: t.inicio }];
  let caminho = t.inicio;
  partes.forEach((parte, i) => {
    caminho += parte + "/";
    const ultimo = i === partes.length - 1;
    itens.push({ nome: ultimo ? (tituloCurto ?? titulo.split(" · ")[0]) : (nomes[parte] ?? parte), href: caminho });
  });
  return itens;
}
const trilha = semMigalhas ? [] : (migalhas ?? montarTrilha());

// ---------- Dados estruturados: um único grafo por página ----------
const pessoa = {
  "@type": "Person",
  "@id": idPessoa,
  name: perfil.nome,
  url: site.href,
  jobTitle: t.cargo,
  description: t.descricaoSite,
  image: { "@type": "ImageObject", url: new URL(perfil.foto, site).href, width: 640, height: 640 },
  email: "mailto:" + perfil.email,
  alumniOf: perfil.formacao.map((f) => ({ "@type": "EducationalOrganization", name: f })),
  address: { "@type": "PostalAddress", addressLocality: "Campinas", addressRegion: "SP", addressCountry: "BR" },
  knowsAbout: perfil.conhecimentos,
  sameAs: [perfil.linkedin, perfil.github, perfil.instagram],
};
const website = {
  "@type": "WebSite",
  "@id": idSite,
  url: site.href,
  name: perfil.nome,
  description: textos.pt.descricaoSite,
  inLanguage: ["pt-BR", "en"],
  author: { "@id": idPessoa },
  publisher: { "@id": idPessoa },
};
const idTrilha = canonica.href + "#trilha";
const pagina = {
  "@type": tipoPagina,
  "@id": canonica.href + "#pagina",
  url: canonica.href,
  name: titulo,
  description: desc,
  inLanguage: t.lang,
  isPartOf: { "@id": idSite },
  primaryImageOfPage: { "@type": "ImageObject", url: imagemAbsoluta, width: 1200, height: 630 },
  ...(tipoPagina === "ProfilePage" ? { mainEntity: { "@id": idPessoa } } : { about: { "@id": idPessoa } }),
  ...(trilha.length > 1 ? { breadcrumb: { "@id": idTrilha } } : {}),
  ...(dataPublicacao ? { datePublished: dataPublicacao } : {}),
  ...(dataModificacao ? { dateModified: dataModificacao } : {}),
};
const noTrilha = trilha.length > 1 ? [{
  "@type": "BreadcrumbList",
  "@id": idTrilha,
  itemListElement: trilha.map((m, i) => ({ "@type": "ListItem", position: i + 1, name: m.nome, item: new URL(m.href, site).href })),
}] : [];
const grafo = { "@context": "https://schema.org", "@graph": [pessoa, website, pagina, ...noTrilha, ...schema] };

// ---------- Rodapé ----------
const recentes = (await getCollection(idioma === "en" ? "articles" : "artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data)
  .slice(0, 3);
const ano = new Date().getFullYear();
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F4F1EA" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preload" href="/fonts/inter-400.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/roboto-mono-400.woff" as="font" type="font/woff" crossorigin />

    <title>{titulo}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={perfil.nome} />
    <meta name="robots" content={semIndexar ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonica} />

    <meta property="og:site_name" content={perfil.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={t.ogLocale} />
    {urlAlternativa && <meta property="og:locale:alternate" content={textos[outroIdioma].ogLocale} />}
    {hrefPt && hrefEn && <link rel="alternate" hreflang="pt-BR" href={new URL(hrefPt, site).href} />}
    {hrefPt && hrefEn && <link rel="alternate" hreflang="en" href={new URL(hrefEn, site).href} />}
    {hrefPt && hrefEn && <link rel="alternate" hreflang="x-default" href={new URL(hrefPt, site).href} />}
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:type" content={tipoImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imagemAbsoluta} />

    {tipo === "article" && dataPublicacao && (
      <meta property="article:published_time" content={dataPublicacao} />
    )}
    {tipo === "article" && dataModificacao && (
      <meta property="article:modified_time" content={dataModificacao} />
    )}
    {tipo === "article" && <meta property="article:author" content={new URL(idioma === "en" ? "/en/about/" : "/sobre/", site).href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={perfil.nome + " · artigos"} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
    <slot name="cabeca" />
  </head>

  <body>
    <a class="pular-conteudo" href="#conteudo">{t.pularConteudo}</a>

    <header class="cabecalho" id="topo">
      <div class="env">
        <a class="marca" href={t.inicio} aria-label={perfil.nome + ", " + t.nomeInicio.toLowerCase()}>
          <span class="selo" aria-hidden="true">RB</span>
          <span class="marca-texto"><b>{perfil.nome}</b><small>{t.subtitulo}</small></span>
        </a>

        <button class="menu-toggle" type="button" aria-label={t.abrirMenu} data-abrir={t.abrirMenu} data-fechar={t.fecharMenu} aria-expanded="false" aria-controls="menu-principal" hidden><svg width="18" height="16" viewBox="0 0 20 18" aria-hidden="true"><path d="M0 1H20M0 9H20M0 17H20" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
        <nav id="menu-principal" aria-label={t.menuPrincipal}>
          {rotas.map((r) => (
            <a
              href={r.href}
              aria-current={estaAtiva(r.href) ? "page" : undefined}
            >
              {r.texto}
            </a>
          ))}
          <a class="seletor-idioma" href={destinoSeletor} hreflang={textos[outroIdioma].lang} lang={textos[outroIdioma].lang} aria-label={t.idioma + ": " + (outroIdioma === "en" ? "English" : "Português")}>
            <span class:list={{ ativo: idioma === "pt" }}>PT</span><span class:list={{ ativo: idioma === "en" }}>EN</span>
          </a>
          <a class="nav-cta" href="#contato">{t.faleComigo}</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      {trilha.length > 1 && (
        <nav class="env migalhas" aria-label={t.trilha}>
          <ol>
            {trilha.map((m, i) => (
              <li>
                {i < trilha.length - 1
                  ? <a href={m.href}>{m.nome}</a>
                  : <span aria-current="page">{m.nome}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="rodape">
      <div class="env">
        <div class="convite" id="contato">
          <div>
            <h2>{t.convite} <em>{t.conviteDestaque}</em></h2>
            <p>{t.freela}</p>
          </div>
          <a class="convite-email" href={"mailto:" + perfil.email}>{perfil.email}</a>
        </div>

        <div class="rodape-grade">
          <div class="rodape-marca">
            <span class="assinatura"><span class="selo" aria-hidden="true">RB</span> {perfil.nome}</span>
            <p>{t.rodapeDescricao} {idioma === "en" ? "Campinas, Brazil" : perfil.local}.</p>
          </div>

          <nav class="rodape-coluna" aria-label={t.paginasSite}>
            <p class="rodape-titulo">{t.navegacao}</p>
            <ul>
              {t.linksRodape.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
            </ul>
          </nav>

          <div class="rodape-coluna">
            <p class="rodape-titulo">{t.artigosRecentes}</p>
            <ul>
              {recentes.map((a) => <li><a href={t.artigosBase + a.id + "/"}>{a.data.titulo}</a></li>)}
            </ul>
          </div>

          <div class="rodape-coluna">
            <p class="rodape-titulo">{t.contato}</p>
            <ul>
              <li><a href={"mailto:" + perfil.email}>{t.email}</a></li>
              <li><a href={perfil.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
              <li><a href={perfil.github} rel="me noopener">GitHub <span aria-hidden="true">↗</span></a></li>
              {idioma === "pt" && <li><a href="/rss.xml">{t.rss}</a></li>}
            </ul>
          </div>
        </div>

        <div class="rodape-base">
          <span>© {ano} {perfil.nome}</span>
          <a href="#topo">{t.voltarTopo} <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#menu-principal");
      if (toggle && nav) {
        toggle.hidden = false;
        nav.classList.add("menu-ready");
        const close = () => { toggle.setAttribute("aria-expanded", "false"); toggle.setAttribute("aria-label", toggle.dataset.abrir); nav.classList.remove("aberto"); };
        toggle.addEventListener("click", () => { const open = toggle.getAttribute("aria-expanded") !== "true"; toggle.setAttribute("aria-expanded", String(open)); toggle.setAttribute("aria-label", open ? toggle.dataset.fechar : toggle.dataset.abrir); nav.classList.toggle("aberto", open); });
        nav.addEventListener("click", (event) => { if ((event.target as HTMLElement).closest("a")) close(); });
        document.addEventListener("keydown", (event) => { if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { close(); toggle.focus(); } });
        matchMedia("(min-width: 761px)").addEventListener("change", close);
      }

      // Revela seções e dispara as animações das figuras quando entram na tela.
      // As figuras continuam observadas: a classe "em-tela" pausa os laços quando saem da tela.
      const animados = document.querySelectorAll("[data-revela], [data-anima]");
      if (!("IntersectionObserver" in window)) {
        animados.forEach((el) => el.classList.add("visivel"));
      } else {
        const observador = new IntersectionObserver((entradas) => {
          for (const entrada of entradas) {
            const alvo = entrada.target;
            if (alvo.hasAttribute("data-anima")) alvo.classList.toggle("em-tela", entrada.isIntersecting);
            if (entrada.isIntersecting) {
              alvo.classList.add("visivel");
              if (!alvo.hasAttribute("data-anima")) observador.unobserve(alvo);
            }
          }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.15 });
        animados.forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>
