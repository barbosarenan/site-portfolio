---
import Base from "../../layouts/Base.astro";
import Chamada from "../../components/Chamada.astro";
import CaseDestaque from "../../components/CaseDestaque.astro";
import { perfil, casos, idPessoa, compassoSchema } from "../../dados/perfil";
const projetos = casos.filter((item) => item.categoria !== "Experiência profissional");
const lista = {
  "@type": "ItemList",
  name: "Projetos de " + perfil.nome,
  itemListElement: [
    { "@type": "ListItem", position: 1, item: { "@id": compassoSchema["@id"] } },
    ...projetos.map((p, i) => ({
      "@type": "ListItem",
      position: i + 2,
      item: { "@type": "CreativeWork", name: p.titulo, description: p.texto, genre: p.categoria, author: { "@id": idPessoa } },
    })),
  ],
};
---
<Base titulo={"Projetos · " + perfil.nome} descricao="Cases demonstrativos, projetos pessoais e experimentos de Renan Barbosa em marketing, SEO, conteúdo e IA." tipoPagina="CollectionPage" schema={[compassoSchema, lista]}>
  <section class="env abertura">
    <span class="rotulo">Projetos</span>
    <h1>Ideias, decisões<br /> e entregas.</h1>
    <p class="resumo">Uma seleção de trabalhos para mostrar como conecto marketing, conteúdo e tecnologia. Cada projeto apresenta sua natureza e seu escopo.</p>
  </section>
  <section class="env secao">
    <div class="section-head"><div><span class="rotulo">Em destaque</span><h2>Case demonstrativo.</h2></div></div>
    <CaseDestaque />
  </section>
  <section class="env secao">
    <div class="section-head">
      <div><span class="rotulo">Outras frentes</span><h2>Projetos e experimentação.</h2></div>
      <a class="text-link" href="/lab/">Explorar o laboratório <span aria-hidden="true">↗</span></a>
    </div>
    <div class="cards-grid three">
      {projetos.map((item) => (
        <article class="project-card">
          <div class="project-top"><span>{item.categoria}</span></div>
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
          <div class="stack">{item.papel}</div>
        </article>
      ))}
    </div>
  </section>
  <Chamada />
</Base>