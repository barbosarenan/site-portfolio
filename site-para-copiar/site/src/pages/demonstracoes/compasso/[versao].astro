---
import { versoes, perguntas } from "../../../dados/compasso";

export function getStaticPaths() {
  return [{ params: { versao: "antes" } }, { params: { versao: "depois" } }];
}

const depois = Astro.params.versao === "depois";
const conteudo = depois ? versoes.depois : versoes.antes;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f7f0" />
    <title>{conteudo.titulo}</title>
    {depois && <meta name="description" content={conteudo.descricao} />}
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <aside class="aviso" aria-label="Identificação do projeto"><div><p><strong>Projeto demonstrativo</strong> · Empresa fictícia · {depois ? "Versão proposta" : "Versão inicial simulada"}</p><a href="/projetos/compasso/">Voltar ao case <span aria-hidden="true">↗</span></a></div></aside>
    <header class="cabecalho-demo env"><a class="marca" href={depois ? "/demonstracoes/compasso/depois/" : "/demonstracoes/compasso/antes/"} aria-label="Compasso, início da demonstração">compasso<span>.</span></a>{depois ? <nav aria-label="Navegação da demonstração"><a href="#como-funciona">Como funciona</a><a href="#recursos">Recursos</a><a href="#duvidas">Dúvidas</a></nav> : <span class="label">organize o seu tempo</span>}</header>
    <main id="conteudo">
      <section class:list={["env", "hero", { "hero-antes": !depois }]}>
        <div class="hero-texto"><p class="label">{depois ? "Sua rotina, no seu ritmo" : "Bem-vindo à Compasso"}</p><h1>{conteudo.h1}</h1><p class="subtitulo">{conteudo.abertura}</p><a class="botao" href={depois ? "#agenda" : "#saiba-mais"}>{conteudo.acao} <span aria-hidden="true">↗</span></a>{depois && <p class="legenda">Interface ilustrativa. Sem cadastro ou reservas reais.</p>}</div>
        <div class="hero-arte" aria-hidden="true"><span class="arte-topo">{depois ? "Uma rotina mais organizada" : "O seu próximo passo"}</span><div class="disco disco-um"></div><div class="disco disco-dois"></div><div class="disco disco-tres"></div><span class="arte-rodape">{depois ? "Serviços · horários · agendamentos" : "Simplicidade · conexão · possibilidades"}</span></div>
      </section>

      {depois ? <>
        <section class="env bloco" id="como-funciona"><div class="secao-topo"><p class="label">Como funciona</p><h2>Um caminho claro entre<br />a disponibilidade e o atendimento.</h2></div><ol class="passos"><li><span class="numero">01</span><h3>Apresente seus serviços</h3><p>Descreva o atendimento e sua duração para orientar a escolha do cliente.</p></li><li><span class="numero">02</span><h3>Defina os horários</h3><p>Organize os períodos disponíveis de acordo com a sua rotina de trabalho.</p></li><li><span class="numero">03</span><h3>Acompanhe os pedidos</h3><p>Consulte os agendamentos em uma visão organizada por horário e serviço.</p></li></ol><p class="legenda">Fluxo previsto no briefing fictício. As funções não estão conectadas a um sistema real.</p></section>
        <section class="agenda-fundo" id="agenda"><div class="env agenda-layout"><div><p class="label">Conheça a proposta</p><h2>Seu dia, em uma<br />visão compartilhada.</h2><p>O exemplo mostra como atendimentos, disponibilidade e intervalos podem conviver na mesma agenda.</p><p class="legenda">[ILUSTRATIVO] Os serviços e horários abaixo foram criados para esta demonstração.</p></div><div class="agenda-painel"><div class="agenda-cabeca"><strong>Agenda de exemplo</strong><span>Dia ilustrativo</span></div><ul class="horarios"><li><time>09:00</time><div class="evento"><span>Atendimento</span><strong>Aula particular</strong><small>60 minutos · online</small></div></li><li><time>10:00</time><div class="evento livre"><span>Disponível</span><strong>Horário aberto</strong><small>Espaço para um novo pedido</small></div></li><li><time>11:00</time><div class="evento"><span>Atendimento</span><strong>Aula particular</strong><small>60 minutos · online</small></div></li><li><time>12:00</time><div class="evento pausa"><span>Intervalo</span><strong>Pausa na agenda</strong></div></li></ul><p class="agenda-nota">Visualização estática. Não permite fazer reservas.</p></div></div></section>
        <section class="env bloco" id="recursos"><div class="secao-topo"><p class="label">Recursos da proposta</p><h2>As informações que precisam<br />estar no mesmo lugar.</h2></div><div class="recursos"><article><span aria-hidden="true">↗</span><h3>Serviços organizados</h3><p>Nome, formato e duração do atendimento descritos antes do pedido.</p></article><article><span aria-hidden="true">◷</span><h3>Disponibilidade visível</h3><p>Uma visão dos horários abertos, ocupados e reservados para intervalos.</p></article><article><span aria-hidden="true">≡</span><h3>Agenda centralizada</h3><p>Uma referência para acompanhar o que está previsto ao longo do dia.</p></article></div></section>
        <section class="env bloco faq" id="duvidas"><div><p class="label">Perguntas frequentes</p><h2>Antes de seguir,<br />algumas respostas.</h2></div><div>{perguntas.map((item) => <details><summary>{item.pergunta}</summary><p>{item.resposta}</p></details>)}</div></section>
      </> : <section class="env bloco generico" id="saiba-mais"><p class="label">Conheça nossas possibilidades</p><h2>Tecnologia para ir além.</h2><p>Inovação, simplicidade e conexão para acompanhar você. Descubra uma experiência pensada para transformar o seu dia a dia.</p></section>}
    </main>
    <footer class="env rodape-demo"><div><strong class="marca">compasso<span>.</span></strong><p>Empresa fictícia criada para o portfólio de Renan Barbosa.</p></div><div><a href="/projetos/compasso/">Ler as decisões do case</a><a href={depois ? "/demonstracoes/compasso/antes/" : "/demonstracoes/compasso/depois/"}>{depois ? "Comparar com a versão inicial" : "Conhecer a versão proposta"}</a></div></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 24px; color-scheme: light; background: #f6f7f0; }
  :global(body) { margin: 0; background: #f6f7f0; color: #21392e; font: 16px/1.65 Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-underline-offset: 4px; }
  :global(a:hover) { color: #8f3825; }
  :global(a:focus-visible), :global(summary:focus-visible) { outline: 3px solid #8f3825; outline-offset: 5px; border-radius: 4px; }
  :global(h1), :global(h2), :global(h3), :global(p) { margin: 0; }
  :global(h1), :global(h2), :global(h3) { letter-spacing: -.045em; text-wrap: balance; }
  .env { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  .pular { position: fixed; top: -100px; left: 12px; z-index: 10; background: #fff; padding: 12px; }
  .pular:focus { top: 12px; }
  .aviso { background: #21392e; color: #eef2e8; font-size: 12px; }
  .aviso > div { width: min(1120px, calc(100% - 48px)); margin-inline: auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; padding-block: 10px; }
  .aviso a:hover { color: #fff; }
  .aviso a { min-height: 28px; display: inline-flex; align-items: center; gap: 16px; }
  .cabecalho-demo { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 18px; padding-block: 24px; border-bottom: 1px solid #d2d9cb; }
  .marca { font-size: 30px; font-weight: 750; letter-spacing: -.07em; text-decoration: none; }
  .marca span { color: #a4412a; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; }
  nav a { font-size: 13px; padding-block: 8px; text-decoration: none; }
  .label { font: 11px/1.5 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 70px; padding-block: 80px; align-items: center; }
  .hero h1 { font-size: clamp(40px, 5.4vw, 64px); line-height: 1.06; max-width: 17ch; margin-block: 20px 24px; }
  .subtitulo { color: #53634e; max-width: 44ch; font-size: 18px; }
  .botao { display: inline-flex; gap: 20px; align-items: center; min-height: 48px; padding: 13px 20px; background: #21392e; color: #fff; border-radius: 7px; margin-top: 28px; text-decoration: none; font-size: 14px; font-weight: 600; }
  .botao:hover { background: #365240; color: #fff; }
  .legenda { font-size: 12px; line-height: 1.6; color: #53634e; margin-top: 16px; max-width: 65ch; }
  .hero-arte { position: relative; background: #e1e8d6; min-height: 430px; border-radius: 110px 110px 12px 12px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; padding: 40px 28px; text-align: center; }
  .arte-topo, .arte-rodape { font: 10px/1.5 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .06em; position: relative; z-index: 1; }
  .disco { position: absolute; width: 180px; height: 180px; border: 1px solid #8b9e7f; border-radius: 50%; left: 50%; transform: translateX(-50%); }
  .disco-um { top: 100px; background: #bacbab; }
  .disco-dois { top: 150px; background: #637e57; }
  .disco-tres { top: 200px; background: #21392e; border-color: #21392e; }
  .bloco { padding-block: 70px; border-top: 1px solid #d2d9cb; }
  h2 { font-size: clamp(28px, 3.3vw, 40px); line-height: 1.15; margin-top: 16px; }
  h3 { font-size: 19px; line-height: 1.3; }
  .passos { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .numero { display: inline-block; font: 12px ui-monospace, monospace; margin-bottom: 22px; border-bottom: 1px solid #8b9e7f; padding-bottom: 10px; }
  .passos p, .recursos p { color: #53634e; font-size: 15px; margin-top: 12px; max-width: 32ch; }
  .agenda-fundo { background: #e9eee2; padding-block: 70px; }
  .agenda-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .agenda-layout h2 { margin-bottom: 24px; }
  .agenda-layout > div > p:not(.label) { max-width: 42ch; color: #53634e; }
  .agenda-painel { border: 1px solid #cad5c0; border-radius: 14px; background: #fffef8; padding: 26px; box-shadow: 0 20px 50px #21392e0d; }
  .agenda-cabeca { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid #d2d9cb; }
  .agenda-cabeca > span { font-size: 11px; color: #53634e; }
  .horarios { list-style: none; padding: 0; margin: 22px 0; display: grid; gap: 12px; }
  .horarios li { display: grid; grid-template-columns: 42px 1fr; gap: 16px; }
  time { padding-top: 12px; font: 12px/1.5 ui-monospace, monospace; color: #53634e; }
  .evento { padding: 12px 16px; border-left: 3px solid #637e57; border-radius: 5px; background: #e9eee2; }
  .evento span, .evento small, .evento strong { display: block; }
  .evento span { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .evento strong { font-size: 14px; margin-top: 4px; }
  .evento small { font-size: 11px; color: #53634e; }
  .livre { border: 1px dashed #8b9e7f; background: #fffef8; }
  .pausa { background: #efeee7; border-color: #c0beb1; }
  .agenda-nota { font-size: 11px; color: #53634e; }
  .recursos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 36px; }
  .recursos article { padding-top: 20px; border-top: 1px solid #cad5c0; }
  .recursos article > span { display: block; font-size: 28px; margin-bottom: 22px; }
  .faq { display: grid; grid-template-columns: 1fr 1.2fr; gap: 70px; }
  details { border-bottom: 1px solid #cad5c0; }
  summary { padding: 20px 0; cursor: pointer; font-weight: 600; line-height: 1.4; }
  details p { color: #53634e; padding-bottom: 20px; font-size: 15px; }
  .rodape-demo { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 32px; padding-block: 40px; border-top: 1px solid #cad5c0; }
  .rodape-demo p { margin-top: 8px; color: #53634e; font-size: 12px; }
  .rodape-demo > div:last-child { display: flex; flex-direction: column; justify-content: center; gap: 12px; font-size: 13px; }
  .generico p:last-child { margin-top: 24px; max-width: 60ch; color: #53634e; }
  @media (max-width: 760px) { .env, .aviso > div { width: calc(100% - 32px); } .hero, .agenda-layout, .faq { grid-template-columns: 1fr; gap: 32px; } .hero { padding-block: 48px; } .hero-arte { min-height: 380px; max-width: 420px; width: 100%; justify-self: center; } .disco { width: 150px; height: 150px; } .disco-um { top: 80px; } .disco-dois { top: 130px; } .disco-tres { top: 180px; } .passos, .recursos { grid-template-columns: 1fr; gap: 28px; } .passos p, .recursos p { max-width: none; } .bloco, .agenda-fundo { padding-block: 48px; } .agenda-painel { padding: 18px; } .cabecalho-demo nav { gap: 20px; } .numero { margin-bottom: 12px; } .hero-antes .hero-arte { display: none; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
